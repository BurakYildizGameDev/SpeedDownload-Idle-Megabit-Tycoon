# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures
/[Mm]emoryCaptures/

# Asset origin tracking IDs
[Aa]ssets/[Aa]ssertion.*

# Unity generated build backups
*_BackUpThisFolder_ButDontShipItWithYourGame/
*_BurstDebugInformation_DoNotShip/

# Visual Studio / VS Code
.vs/
.vscode/
.claude/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity profiler and crash artifacts
sysinfo.txt
*.stackdump

# Builds and symbols (keep repo size small; release on GitHub Releases instead)
*.apk
*.aab
*.symbols.zip
*mapping.txt
.utmp/
*.slnx

# OS generated
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
